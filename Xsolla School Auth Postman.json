    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SuperSecret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "signup"
              ]
            },
            "description": "Пароль должен быть от 12 до 25 символов (см. handlers.CreateUser)."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('jwt', body.jwt);",
                  "    pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SuperSecret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "При успехе автоматически сохраняет jwt/refresh_token в переменные коллекции (см. вкладку Tests)."
          },
          "response": []
        },
        {
          "name": "Refresh token(Need to be implemented)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/token?refresh_token={{refresh_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token"
              ],
              "query": [
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}"
                }
              ]
            },
            "description": "IssueJWT сейчас не реализован (пустое тело функции, TODO в handlers.go:460)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get user cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user/cart",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "cart"
              ]
            },
            "description": "Использует X-User-ID (TODO: protect this method — пока не защищён JWT)."
          },
          "response": []
        },
        {
          "name": "Upsert cart item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/cart/items/{{item_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "cart",
                "items",
                "{{item_id}}"
              ]
            },
            "description": "Требует Authorization: Bearer <jwt>. Получите jwt через запрос Login."
          },
          "response": []
        },
        {
          "name": "Remove cart item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user/cart/items/{{item_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "cart",
                "items",
                "{{item_id}}"
              ]
            },
            "description": "Использует X-User-ID (TODO: Protect this method — пока не защищён JWT)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{user_id}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "key-{{$randomUUID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"line_items\": [\n    { \"item_id\": 1, \"quantity\": 1, \"price\": 120000 }\n  ],\n  \"total\": 120000\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Требует X-User-ID и Idempotency-Key (TODO: protect this method — пока не защищён JWT)."
          },
          "response": []
        }
      ]
    }
